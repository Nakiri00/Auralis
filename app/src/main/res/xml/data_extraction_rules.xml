<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>

    <cloud-backup>

        <!-- Jangan unggah filesDir ke cloud backup. -->
        <exclude
            domain="file"
            path="." />

    </cloud-backup>

    <device-transfer>

        <!--
            Jangan pindahkan filesDir ke perangkat baru.
            Audio History harus tetap device-local.
        -->
        <exclude
            domain="file"
            path="." />

    </device-transfer>

</data-extraction-rules>