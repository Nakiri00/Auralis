<resources xmlns:tools="http://schemas.android.com/tools">
<!-- Base application theme. -->
    <style name="Base.Theme.MusicChords" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnBackground">@color/black</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="android:textColorPrimary">@color/black</item>

        <item name="colorPrimary">@color/black</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorPrimaryContainer">@color/black</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondaryContainer">@color/black</item>
        <item name="colorOnSecondaryContainer">@color/white</item>

        <item name="colorSurfaceVariant">#EEEEEE</item>
        <item name="colorOnSurfaceVariant">@color/black</item>
    </style>

    <style name="Theme.MusicChords" parent="Base.Theme.MusicChords" />

    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.BottomBlackNav</item>
    </style>

    <style name="ThemeOverlay.App.BottomBlackNav" parent="">
        <item name="colorSurface">@color/black</item>
        <item name="colorSurfaceContainer">@color/black</item>

        <item name="colorSecondaryContainer">#333333</item>

        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnSecondaryContainer">@color/white</item>

        <item name="colorOnSurfaceVariant">#9E9E9E</item>
    </style>

<!-- Base dialog: inherits Material3 day/night colors + rounded corners -->
<style name="App.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
    <item name="shapeAppearanceOverlay">@style/App.AlertDialog.Shape</item>
</style>

<!-- Rounded corner shape used by all app dialogs -->
<style name="App.AlertDialog.Shape" parent="">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">20dp</item>
</style>

<!-- Destructive dialog (e.g. delete): positive button turns red via colorError -->
<style name="App.AlertDialog.Destructive" parent="App.AlertDialog">
    <item name="buttonBarPositiveButtonStyle">@style/App.AlertDialog.Destructive.Button</item>
</style>

<style name="App.AlertDialog.Destructive.Button" parent="Widget.Material3.Button.TextButton.Dialog">
    <item name="android:textColor">?attr/colorError</item>
</style>
</resources>